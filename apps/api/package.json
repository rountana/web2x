{
  "name": "@web2x/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --import=tsx/esm --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "node --env-file=.env.local --import=tsx/esm src/workers/workerEntry.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --reporter=verbose tests/integration",
    "chunk:backfill": "node --env-file=.env.local --import=tsx/esm src/scripts/backfillChunks.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@hono/node-server": "^1.12.0",
    "@mozilla/readability": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "@web2x/shared": "workspace:*",
    "bullmq": "^5.12.0",
    "drizzle-orm": "^0.31.0",
    "hono": "^4.4.0",
    "ioredis": "^5.4.0",
    "jsdom": "^25.0.0",
    "pg": "^8.12.0",
    "puppeteer": "^22.12.0",
    "turndown": "^7.2.0",
    "unpdf": "^1.6.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.39",
    "@types/pg": "^8.11.0",
    "@types/turndown": "^5.0.4",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.22.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0",
    "vitest": "^2"
  }
}
